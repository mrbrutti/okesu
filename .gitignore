# Compiled binaries (built locally with `go build`).
/okesu
/okesu-cp
/okesu-cp-linux-amd64
/okesu-cp-linux-arm64
/okesu-linux-amd64
/okesu-linux-arm64
/okesu-darwin-amd64
/okesu-darwin-arm64
/okesu-freebsd-amd64
/okesu-openbsd-amd64
/okesu-illumos-amd64
/okesu-solaris-amd64

# Local CP runtime artifacts (generated alongside cp.db on first run).
/cp.db
/cp.db-wal
/cp.db-shm
/ca.crt
/ca.key
/server.crt
/server.key
/mgmt-server.crt
/mgmt-server.key

# Frontend build inputs/outputs.
/web/node_modules/
/web/dist/
/web/tsconfig.tsbuildinfo

# Embedded UI build (regenerated by `cd web && npm run build`).
/controlplane/ui/dist/*
!/controlplane/ui/dist/.gitkeep

# Generated enrollment packages — produced by the CP packaging API.
*.tar.gz
*.deb
*.rpm
*.pkg

# Lab runtime state — DBs, certs, logs created by start-federated.sh / start.sh.
/test/stack/run-fed/
/test/stack/run/

# Stray build-output dir.
/dist/

# Transient OCI env files with injected secrets (e.g. FEDERATION_TOKEN).
dist/oci/*/env.injected

# Operator-local CLI scheduler state (Claude Code internals).
/.claude/scheduled_tasks.lock

# Local git worktrees used for feature isolation.
/.claude/worktrees/

# OS / editor noise.
.DS_Store
*.swp
.env.oci
/deploy/oci/terraform/*.tfvars
!/deploy/oci/terraform/*.tfvars.example
