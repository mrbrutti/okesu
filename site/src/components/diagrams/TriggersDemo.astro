---
// Orchestrations / Triggers. 6-second loop:
//   Three trigger sources funnel into one orchestration run. Each
//   trigger pulses in turn.
---

<svg viewBox="0 0 480 200" class="w-full h-auto" role="img"
     aria-label="Animated demo: three trigger sources — finding, manual, cron — funnel into a single orchestration run.">
  <!-- Trigger sources -->
  <g class="trigger trigger-1">
    <rect x="20" y="20" width="120" height="40" rx="6" fill="#ffffff" stroke="#e5e7eb" />
    <text x="80" y="44" text-anchor="middle" font-size="11" fill="#0f172a">finding match</text>
  </g>
  <g class="trigger trigger-2">
    <rect x="20" y="80" width="120" height="40" rx="6" fill="#ffffff" stroke="#e5e7eb" />
    <text x="80" y="104" text-anchor="middle" font-size="11" fill="#0f172a">manual run</text>
  </g>
  <g class="trigger trigger-3">
    <rect x="20" y="140" width="120" height="40" rx="6" fill="#ffffff" stroke="#e5e7eb" />
    <text x="80" y="164" text-anchor="middle" font-size="11" fill="#0f172a">cron schedule</text>
  </g>

  <!-- Funnel arrows -->
  <line x1="140" y1="40"  x2="280" y2="100" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />
  <line x1="140" y1="100" x2="280" y2="100" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />
  <line x1="140" y1="160" x2="280" y2="100" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />

  <!-- Orchestration run -->
  <rect x="280" y="80" width="180" height="40" rx="6" fill="#f5f3ff" stroke="#ede9fe" />
  <text x="370" y="104" text-anchor="middle" font-size="11" fill="#5b21b6" font-weight="600">orchestration run</text>
</svg>

<style>
  .trigger rect { stroke: #e5e7eb; }

  @media (prefers-reduced-motion: no-preference) {
    .trigger-1 rect { animation: trigger-pulse 6s ease-in-out 0s infinite; }
    .trigger-2 rect { animation: trigger-pulse 6s ease-in-out 2s infinite; }
    .trigger-3 rect { animation: trigger-pulse 6s ease-in-out 4s infinite; }

    @keyframes trigger-pulse {
      0%, 90%, 100% { stroke: #e5e7eb; fill: #ffffff; }
      5%            { stroke: #ede9fe; fill: #f5f3ff; }
      15%           { stroke: #e5e7eb; fill: #ffffff; }
    }
  }
</style>
