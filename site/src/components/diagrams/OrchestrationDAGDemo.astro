---
// Orchestrations concept-page anchor. 10-second loop, annotated DAG.
// Same shape as the home demo but with `agent:`, `node:`, `nodes:`,
// and `approval:` field labels under each step name.
---

<svg viewBox="0 0 880 240" class="w-full h-auto" role="img"
     aria-label="Animated diagram: a four-step orchestration spec — annotated with agent, node, and approval field names — runs through fan-out and an approval gate.">
  <!-- Step 1 -->
  <g class="dag-step dag-1">
    <rect class="dag-bg" x="20" y="80" width="140" height="100" rx="8" />
    <rect class="dag-stripe dag-1-stripe" x="20" y="80" width="140" height="3" />
    <text x="90" y="108" text-anchor="middle" font-size="13" fill="#0f172a" font-weight="600">scan</text>
    <text x="35" y="128" font-size="9" fill="#64748b" font-family="ui-monospace">agent: edr-investigator</text>
    <text x="35" y="142" font-size="9" fill="#64748b" font-family="ui-monospace">node: web-prod-01</text>
  </g>

  <!-- Step 2: fanout -->
  <g class="dag-step dag-2">
    <rect class="dag-bg dag-fanout" x="220" y="60" width="200" height="140" rx="8" />
    <rect class="dag-stripe dag-2-stripe" x="220" y="60" width="200" height="3" />
    <text x="320" y="92" text-anchor="middle" font-size="13" fill="#5b21b6" font-weight="600">edr-triage</text>
    <text x="235" y="112" font-size="9" fill="#64748b" font-family="ui-monospace">agent: edr-triage</text>
    <text x="235" y="126" font-size="9" fill="#64748b" font-family="ui-monospace">nodes: [w1, w2, w3, w4, w5, w6]</text>
    <rect x="240" y="138" width="160" height="6" rx="2" fill="#e2e8f0" />
    <rect class="hist-2-fill" x="240" y="138" height="6" rx="2" fill="#22c55e" />
    <g>
      <circle class="dag-dot dag-dot-1" cx="245" cy="160" r="4" fill="#cbd5e1" />
      <circle class="dag-dot dag-dot-2" cx="265" cy="160" r="4" fill="#cbd5e1" />
      <circle class="dag-dot dag-dot-3" cx="285" cy="160" r="4" fill="#cbd5e1" />
      <circle class="dag-dot dag-dot-4" cx="305" cy="160" r="4" fill="#cbd5e1" />
      <circle class="dag-dot dag-dot-5" cx="325" cy="160" r="4" fill="#cbd5e1" />
      <circle class="dag-dot dag-dot-6" cx="345" cy="160" r="4" fill="#cbd5e1" />
    </g>
  </g>

  <!-- Step 3 -->
  <g class="dag-step dag-3">
    <rect class="dag-bg" x="480" y="80" width="140" height="100" rx="8" />
    <rect class="dag-stripe dag-3-stripe" x="480" y="80" width="140" height="3" />
    <text x="550" y="108" text-anchor="middle" font-size="13" fill="#0f172a" font-weight="600">summarize</text>
    <text x="495" y="128" font-size="9" fill="#64748b" font-family="ui-monospace">agent: orchestrator</text>
    <text x="495" y="142" font-size="9" fill="#64748b" font-family="ui-monospace">node: cp</text>
  </g>

  <!-- Step 4 (approval) -->
  <g class="dag-step dag-4">
    <rect class="dag-bg dag-approval" x="680" y="80" width="180" height="100" rx="8" />
    <rect class="dag-stripe dag-4-stripe" x="680" y="80" width="180" height="3" />
    <text x="770" y="108" text-anchor="middle" font-size="13" fill="#b91c1c" font-weight="600">⏸ contain</text>
    <text x="695" y="128" font-size="9" fill="#b91c1c" font-family="ui-monospace">agent: forensic-collector</text>
    <text x="695" y="142" font-size="9" fill="#b91c1c" font-family="ui-monospace">approval: required</text>
  </g>

  <!-- Edges -->
  <g stroke="#94a3b8" stroke-width="2" fill="none" marker-end="url(#arr-dag)">
    <line x1="160" y1="120" x2="220" y2="120" />
    <line x1="420" y1="120" x2="480" y2="120" />
    <line x1="620" y1="120" x2="680" y2="120" />
  </g>

  <defs>
    <marker id="arr-dag" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8" />
    </marker>
  </defs>
</svg>

<style>
  .dag-bg { fill: #ffffff; stroke: #e5e7eb; }
  .dag-fanout { fill: #f5f3ff; stroke: #ede9fe; }
  .dag-approval { fill: #fef2f2; stroke: #fecaca; }
  .dag-stripe { fill: #cbd5e1; }
  .hist-2-fill { width: 0; }

  @media (prefers-reduced-motion: no-preference) {
    /* 10s loop */
    .dag-1-stripe { animation: dag-1-stripe 10s linear infinite; }
    @keyframes dag-1-stripe {
      0%, 8%   { fill: #cbd5e1; }
      8%, 18%  { fill: #3b82f6; }
      18%, 100% { fill: #22c55e; }
    }
    .dag-2-stripe { animation: dag-2-stripe 10s linear infinite; }
    @keyframes dag-2-stripe {
      0%, 22%   { fill: #cbd5e1; }
      22%, 56%  { fill: #3b82f6; }
      56%, 100% { fill: #ef4444; }
    }
    .hist-2-fill { animation: hist-2-grow 10s linear infinite; }
    @keyframes hist-2-grow {
      0%, 22%   { width: 0; }
      56%, 100% { width: 160px; }
    }
    .dag-dot-1 { animation: dag-dot-1 10s linear infinite; }
    .dag-dot-2 { animation: dag-dot-2 10s linear infinite; }
    .dag-dot-3 { animation: dag-dot-3 10s linear infinite; }
    .dag-dot-4 { animation: dag-dot-4 10s linear infinite; }
    .dag-dot-5 { animation: dag-dot-5 10s linear infinite; }
    .dag-dot-6 { animation: dag-dot-6 10s linear infinite; }
    @keyframes dag-dot-1 { 0%, 26% { fill: #cbd5e1; } 28%, 100% { fill: #22c55e; } }
    @keyframes dag-dot-2 { 0%, 31% { fill: #cbd5e1; } 33%, 100% { fill: #22c55e; } }
    @keyframes dag-dot-3 { 0%, 36% { fill: #cbd5e1; } 38%, 100% { fill: #22c55e; } }
    @keyframes dag-dot-4 { 0%, 41% { fill: #cbd5e1; } 43%, 100% { fill: #22c55e; } }
    @keyframes dag-dot-5 { 0%, 46% { fill: #cbd5e1; } 48%, 100% { fill: #ef4444; } }
    @keyframes dag-dot-6 { 0%, 51% { fill: #cbd5e1; } 53%, 100% { fill: #22c55e; } }

    .dag-3-stripe { animation: dag-3-stripe 10s linear infinite; }
    @keyframes dag-3-stripe {
      0%, 56%   { fill: #cbd5e1; }
      56%, 72%  { fill: #3b82f6; }
      72%, 100% { fill: #22c55e; }
    }
    .dag-4-stripe { animation: dag-4-stripe 10s linear infinite; }
    @keyframes dag-4-stripe {
      0%, 72%   { fill: #cbd5e1; }
      72%, 92%  { fill: #fbbf24; }
      92%, 100% { fill: #22c55e; }
    }
  }
</style>
