---
// Daimon lifecycle / heartbeat. 4-second loop:
//   pulsing heartbeat circle, "last seen: 0.4s ago" counter
//   resets every 4s.
---

<div class="bg-bg border border-border rounded-lg p-5 inline-flex items-center gap-3" role="img"
     aria-label="Animated demo: a daimon's heartbeat circle pulses every few seconds; a 'last seen' counter resets each tick.">
  <div class="relative w-10 h-10 flex items-center justify-center">
    <span class="heartbeat-ring absolute inset-0 rounded-full border-2 border-brand-500"></span>
    <span class="heartbeat-dot w-3 h-3 rounded-full bg-brand-500"></span>
  </div>
  <div class="text-[12px] font-mono text-ink-dim">
    <div class="text-ink font-semibold">daimon: web-prod-01</div>
    <div class="text-[11px]">last seen: <span class="last-seen">0.4</span>s ago</div>
  </div>
</div>

<style>
  .heartbeat-ring { opacity: 0; transform: scale(1); }
  .heartbeat-dot { transform: scale(1); }

  @media (prefers-reduced-motion: no-preference) {
    .heartbeat-ring { animation: hb-ring 4s ease-out infinite; }
    @keyframes hb-ring {
      0%   { opacity: 0.6; transform: scale(0.6); }
      80%  { opacity: 0; transform: scale(1.6); }
      100% { opacity: 0; transform: scale(1.6); }
    }

    .heartbeat-dot { animation: hb-dot 4s ease-in-out infinite; }
    @keyframes hb-dot {
      0%, 100% { transform: scale(1); }
      10%      { transform: scale(1.3); }
    }

    .last-seen { animation: last-seen-text 4s steps(40) infinite; }
    @keyframes last-seen-text {
      0%, 100% { color: #64748b; }
    }
  }
</style>
