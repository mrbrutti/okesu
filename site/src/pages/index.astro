---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ConceptCard from '../components/ConceptCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import OperatorView from '../components/OperatorView.astro';
import OrchestrationLoopDemo from '../components/diagrams/OrchestrationLoopDemo.astro';
---

<Base
  title="Okesu"
  description="Orchestrate your security team like an orchestra. Okesu coordinates a fleet of AI agents across your hosts."
>
  <Hero />

  <section class="max-w-page mx-auto px-6 mb-16">
    <div class="text-center mb-4">
      <span class="text-[10px] uppercase tracking-wide text-ink-mute font-bold">Live playbook · auto-replays</span>
    </div>
    <div class="bg-panel border border-border rounded-xl shadow-card p-6 md:p-8">
      <OrchestrationLoopDemo />
    </div>
  </section>

  <section class="max-w-page mx-auto px-6 mb-4">
    <div class="grid md:grid-cols-3 gap-4">
      <ConceptCard
        href="/concepts/daimons"
        title="Daimons"
        glyph="▦"
        description="The long-running daemon installed on each host. Listens for run dispatches, executes agents, streams findings back."
      />
      <ConceptCard
        href="/concepts/agents"
        title="Agents"
        glyph="✦"
        description="Prompt-driven workers (Claude, Codex, your own). They run on the daimon, emit structured findings as JSONL."
      />
      <ConceptCard
        href="/concepts/orchestrations"
        title="Orchestrations"
        glyph="⊞"
        description="YAML specs that sequence agents into playbooks. Fan out across hosts, gate on approval, branch on results."
      />
    </div>
  </section>

  <FeatureGrid />

  <section class="max-w-page mx-auto px-6 my-12">
    <div class="text-center mb-4">
      <span class="text-[10px] uppercase tracking-wide text-ink-mute font-bold">In the operator's console</span>
    </div>
    <OperatorView
      src="dashboard"
      alt="Okesu Control Plane dashboard — federated daimon counts, finding charts, automation runs by status."
      url="okesu / Dashboard"
      caption="The dashboard at a glance: federated fleet health, finding counts by severity, recent automation activity."
    />
  </section>
</Base>
