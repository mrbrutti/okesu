[Unit]
Description=Okesu autonomous agent — %i
Documentation=https://github.com/section9labs/okesu
After=network-online.target
Wants=network-online.target
# Allow 5 restarts within 5 minutes before systemd gives up.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# The instance name (%i) must match an agent file in /etc/okesu/agents/.
ExecStart=/usr/local/bin/okesu daemon --agent %i
Restart=on-failure
RestartSec=10s

# Run as a dedicated low-privilege user.
User=okesu
Group=okesu

# Filesystem hardening.
WorkingDirectory=/var/lib/okesu/%i
ReadWritePaths=/var/lib/okesu /var/log/okesu /etc/okesu /tmp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Drop all capabilities — okesu needs none for normal operation.
CapabilityBoundingSet=

# Environment — agent-specific secrets go in /etc/okesu/agents/%i.env (mode 0600).
EnvironmentFile=-/etc/okesu/agents/%i.env

# Pass logs to journald; structured JSONL lines are preserved as-is.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=okesu-%i

# Allow the process to receive SIGHUP for hot config reload.
KillSignal=SIGTERM
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
