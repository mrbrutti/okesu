# Rendered by deploy/oci/render — read by systemd via EnvironmentFile=
# in /etc/systemd/system/okesu-cp.service. Do not edit by hand.
OKESU_CP_FLEET_ANTHROPIC_API_KEY=sk-ant-test

# Federation — child CP (publishes catalog/IOC data to parent's S3 bucket).
OKESU_CP_FEDERATION_TOKEN=fed-token-child-test
OKESU_CP_INSTANCE_ID=cp-child-001
OKESU_CP_FEDERATION_S3_PUBLISH_BUCKET=okesu-parent-bucket
OKESU_CP_FEDERATION_S3_PUBLISH_ENDPOINT=ns.compat.objectstorage.us-ashburn-1.oraclecloud.com
OKESU_CP_FEDERATION_S3_PUBLISH_REGION=us-ashburn-1
OKESU_CP_FEDERATION_S3_PUBLISH_USE_SSL=true
OKESU_CP_FEDERATION_S3_PUBLISH_ACCESS_KEY=PARENT-AKID-EXAMPLE
OKESU_CP_FEDERATION_S3_PUBLISH_SECRET_KEY=parent-secret-key-test
