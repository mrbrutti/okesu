# Rendered by deploy/oci/render — read by systemd via EnvironmentFile=
# in /etc/systemd/system/okesu-cp.service. Do not edit by hand.
OKESU_CP_FLEET_ANTHROPIC_API_KEY={{ envOr .OperatorEnv "ANTHROPIC_API_KEY" "" }}
{{- if index .OperatorEnv "OPENAI_API_KEY" }}
OKESU_CP_FLEET_OPENAI_API_KEY={{ index .OperatorEnv "OPENAI_API_KEY" }}
{{- end }}
{{- if index .OperatorEnv "OIDC_CLIENT_SECRET" }}
OKESU_CP_OIDC_CLIENT_SECRET={{ index .OperatorEnv "OIDC_CLIENT_SECRET" }}
{{- end }}
{{- if eq .Mode "parent" }}

# Federation — parent CP (issues tokens, accepts child enrollments).
OKESU_CP_FEDERATION_TOKEN={{ envOr .OperatorEnv "FEDERATION_TOKEN" "" }}
OKESU_CP_INSTANCE_ID={{ envOr .OperatorEnv "CP_INSTANCE_ID" "cp-parent-001" }}
{{- end }}
{{- if eq .Mode "child" }}

# Federation — child CP (publishes catalog/IOC data to parent's S3 bucket).
OKESU_CP_FEDERATION_TOKEN={{ envOr .OperatorEnv "PARENT_FEDERATION_TOKEN" "" }}
OKESU_CP_INSTANCE_ID={{ envOr .OperatorEnv "CP_INSTANCE_ID" "cp-child-001" }}
OKESU_CP_FEDERATION_S3_PUBLISH_BUCKET={{ envOr .OperatorEnv "PARENT_FEDERATION_BUCKET" "" }}
OKESU_CP_FEDERATION_S3_PUBLISH_ENDPOINT={{ envOr .OperatorEnv "PARENT_FEDERATION_ENDPOINT" "" }}
OKESU_CP_FEDERATION_S3_PUBLISH_REGION={{ envOr .OperatorEnv "PARENT_FEDERATION_REGION" "" }}
OKESU_CP_FEDERATION_S3_PUBLISH_USE_SSL=true
OKESU_CP_FEDERATION_S3_PUBLISH_ACCESS_KEY={{ envOr .OperatorEnv "PARENT_FEDERATION_ACCESS_KEY" "" }}
OKESU_CP_FEDERATION_S3_PUBLISH_SECRET_KEY={{ envOr .OperatorEnv "PARENT_FEDERATION_SECRET_KEY" "" }}
{{- end }}
